---
import Container from '@/components/ui/Container.astro';
import { getCollection } from 'astro:content';

const music = await getCollection('discography');
const stages = await getCollection('stages');
const events = await getCollection('events');
const news = (await getCollection('news')).filter((item) => item.data.publicationStatus === 'published');
const verified = news.filter((item) => item.data.verificationStatus === 'verified').length;

const guides = [
  { number: String(music.length).padStart(2, '0'), title: '作品档案', text: '从专辑、单曲到影视原声，按发行日期进入作品页与可用平台。', href: '/music', action: '浏览作品' },
  { number: String(stages.length + events.length).padStart(2, '0'), title: '舞台现场', text: '将综艺演出与线下行程分开归档，减少时间线里的信息噪音。', href: '/stages', action: '查看舞台' },
  { number: String(verified).padStart(2, '0'), title: '来源核验', text: '新闻会明确区分已交叉核验、来源待补充与审核中内容。', href: '/news', action: '阅读动态' },
];
---

<section class="relative overflow-hidden bg-[#0e0b1a] py-16 sm:py-20">
  <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/20 to-transparent"></div>
  <Container>
    <div class="mb-9 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
      <div>
        <p class="text-[11px] font-semibold tracking-[0.24em] text-primary-300 uppercase">Start here</p>
        <h2 class="mt-3 text-3xl font-heading font-bold text-white sm:text-4xl">一处可以慢慢读的档案</h2>
      </div>
      <p class="max-w-md text-sm leading-6 text-white/45">不把页面做成一串链接。先选择你想进入的线索，再沿着作品、舞台和时间继续探索。</p>
    </div>

    <div class="grid gap-px overflow-hidden rounded-2xl border border-white/10 bg-white/10 md:grid-cols-3">
      {guides.map((guide) => (
        <a href={guide.href} class="group relative bg-[#151122] p-7 transition hover:bg-[#1b1630] sm:p-8">
          <p class="text-4xl font-heading font-bold text-primary-300/80">{guide.number}</p>
          <h3 class="mt-8 text-xl font-heading font-bold text-white">{guide.title}</h3>
          <p class="mt-3 min-h-12 text-sm leading-6 text-white/50">{guide.text}</p>
          <span class="mt-7 inline-flex items-center gap-2 text-sm font-medium text-white/70 transition group-hover:text-primary-200">{guide.action} <span aria-hidden="true">→</span></span>
        </a>
      ))}
    </div>
  </Container>
</section>
