---
import Container from '@/components/ui/Container.astro';
import type { CollectionEntry } from 'astro:content';

export interface Props {
  items: CollectionEntry<'discography'>[];
}
const { items } = Astro.props;

const typeLabels: Record<string, string> = {
  album: '专辑',
  single: '单曲',
  ost: 'OST',
};
---

<section class="py-16 sm:py-20 bg-gradient-to-b from-[#0a0a1a] to-[#120a2e]">
  <Container>
    <div class="flex items-center justify-between mb-10">
      <h2 class="text-2xl sm:text-3xl font-heading font-bold text-white/90">音乐作品</h2>
      <a href="/music" class="text-sm text-primary-300 hover:text-primary-200 font-medium transition-colors">
        查看全部作品 →
      </a>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        items.slice(0, 4).map((item) => {
          const [c1, c2] = item.data.coverColor ? item.data.coverColor.split('-') : ['#8b5cf6', '#7c3aed'];
          return (
            <a href={`/music/${item.id}`} class="group block">
              <div class="backdrop-blur-xl bg-white/[0.05] rounded-2xl border border-white/10 overflow-hidden card-hover h-full">
                <div class="aspect-square flex items-center justify-center relative overflow-hidden" style={`background: linear-gradient(135deg, ${c1}, ${c2})`}>
                  <img src={`/images/covers/${item.id}.jpg`} alt={item.data.title} class="absolute inset-0 w-full h-full object-cover" loading="lazy" onerror="this.style.display='none'" />
                  <div class="absolute inset-0 bg-gradient-to-br from-black/20 to-transparent" />
                  <p class="relative z-10 text-white/90 text-base font-heading font-bold px-2 text-center leading-tight">{item.data.title}</p>
                </div>
                <div class="p-3.5 text-center">
                  <p class="text-sm font-medium text-white/85 group-hover:text-primary-300 transition-colors truncate">{item.data.title}</p>
                  <p class="text-[11px] text-white/40 mt-0.5">{new Date(item.data.releaseDate).getFullYear()} · {typeLabels[item.data.type] || item.data.type}</p>
                </div>
              </div>
            </a>
          );
        })
      }
    </div>
  </Container>
</section>
