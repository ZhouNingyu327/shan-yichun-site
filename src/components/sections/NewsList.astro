---
import Container from '@/components/ui/Container.astro';
import type { CollectionEntry } from 'astro:content';

export interface Props {
  posts: CollectionEntry<'news'>[];
}
const { posts } = Astro.props;
---

<section class="py-16 sm:py-20 bg-[#0a0a1a]">
  <Container>
    <div class="flex items-center justify-between mb-10">
      <h2 class="text-2xl sm:text-3xl font-heading font-bold text-white/90">最新动态</h2>
      <a href="/news" class="text-sm text-primary-300 hover:text-primary-200 font-medium transition-colors">
        查看全部 →
      </a>
    </div>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        posts.map((post) => (
          <a href={`/news/${post.id}`} class="group">
            <article class="backdrop-blur-xl bg-white/[0.05] rounded-2xl border border-white/10 p-6 h-full card-hover">
              <div class="flex items-center gap-2 mb-3">
                <span class="text-xs text-white/45">
                  {new Date(post.data.publishDate).toLocaleDateString('zh-CN')}
                </span>
                <span class="text-xs text-white/25">·</span>
                <span class="text-xs text-white/45">{post.data.source}</span>
              </div>
              <h3 class="text-base font-semibold text-white/85 group-hover:text-primary-300 transition-colors mb-2 line-clamp-2">
                {post.data.title}
              </h3>
              <p class="text-sm text-white/55 leading-relaxed line-clamp-3">
                {post.data.summary}
              </p>
              <div class="flex flex-wrap gap-1.5 mt-4">
                {post.data.tags.slice(0, 3).map((tag) => (
                  <span class="text-xs px-2.5 py-0.5 rounded-full bg-primary-500/15 text-primary-300 border border-primary-400/20">{tag}</span>
                ))}
              </div>
            </article>
          </a>
        ))
      }
    </div>
  </Container>
</section>
