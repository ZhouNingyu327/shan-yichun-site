---
import { SITE, SOCIAL_LINKS } from '@/utils/constants';
import Container from '@/components/ui/Container.astro';
import { getCollection } from 'astro:content';

const allMusic = await getCollection('discography');
const allEvents = await getCollection('events');
const allAwards = await getCollection('awards');
const songCount = allMusic.length;
const awardWon = allAwards.filter(a => a.data.result === 'won').length;
---

<section class="relative min-h-[80vh] flex items-center bg-gradient-to-br from-[#0a0a1a] via-[#120a2e] to-[#0f1923] overflow-hidden">
  <!-- 彩色模糊光斑 -->
  <div class="absolute inset-0 overflow-hidden">
    <div class="absolute top-[-15%] left-[-5%] w-[35rem] h-[35rem] rounded-full blur-[120px] opacity-30 animate-hb" style="background: linear-gradient(135deg, #8b5cf6, #ec4899)" />
    <div class="absolute bottom-[-20%] right-[-5%] w-[30rem] h-[30rem] rounded-full blur-[120px] opacity-20 animate-hb animation-delay-2" style="background: linear-gradient(135deg, #06b6d4, #8b5cf6)" />
    <div class="absolute top-[25%] right-[15%] w-[20rem] h-[20rem] rounded-full blur-[100px] opacity-15 animate-hb animation-delay-4" style="background: linear-gradient(135deg, #f59e0b, #ec4899)" />
  </div>

  <!-- 声波环 -->
  <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
    <div class="relative w-full max-w-2xl aspect-square flex items-center justify-center">
      <div class="absolute w-[100%] aspect-square rounded-full border border-white/[0.03] animate-hr" style="animation-duration: 5s" />
      <div class="absolute w-[80%] aspect-square rounded-full border border-white/[0.04] animate-hr" style="animation-duration: 6s; animation-delay: 1s" />
      <div class="absolute w-[60%] aspect-square rounded-full border border-white/[0.05] animate-hr" style="animation-duration: 7s; animation-delay: 2s" />
    </div>
  </div>

  <!-- 浮动音符 -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none select-none">
    <span class="absolute top-[15%] left-[10%] text-3xl text-white/[0.05] animate-hn" style="animation-delay: 0s">♪</span>
    <span class="absolute top-[60%] right-[8%] text-4xl text-white/[0.04] animate-hn" style="animation-delay: 2s">♫</span>
    <span class="absolute top-[30%] right-[30%] text-2xl text-white/[0.04] animate-hn" style="animation-delay: 4s">♩</span>
    <span class="absolute top-[75%] left-[20%] text-3xl text-white/[0.04] animate-hn" style="animation-delay: 3s">♬</span>
  </div>

  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[80rem] h-px bg-gradient-to-r from-transparent via-white/15 to-transparent" />

  <Container class="relative z-10 py-24">
    <div class="max-w-2xl">
      <p class="text-sm tracking-[0.3em] text-white/40 font-light uppercase mb-5">{SITE.nameEn}</p>
      <h1 class="text-6xl sm:text-7xl lg:text-8xl font-heading font-bold text-white leading-tight mb-6 drop-shadow-lg">
        {SITE.name}
      </h1>
      <p class="text-xl text-white/60 font-light leading-relaxed mb-8">{SITE.tagline}</p>

      <div class="flex flex-wrap gap-3 mt-8">
        <a
          href="/about"
          class="inline-flex items-center px-7 py-3 bg-primary-500/80 text-white rounded-full font-medium hover:bg-primary-500 transition-all shadow-sm backdrop-blur-xl border border-primary-400/30"
        >
          了解单依纯
        </a>
        <a
          href="/music"
          class="inline-flex items-center px-7 py-3 bg-white/8 text-white/80 border border-white/15 rounded-full font-medium hover:bg-white/15 transition-all backdrop-blur-xl"
        >
          探索音乐作品
        </a>
        <a
          href="/events"
          class="inline-flex items-center px-7 py-3 bg-white/8 text-white/80 border border-white/15 rounded-full font-medium hover:bg-white/15 transition-all backdrop-blur-xl"
        >
          🎤 演唱会
        </a>
      </div>

      <!-- 数据概览 -->
      <div class="grid grid-cols-3 gap-3 mt-12 max-w-md">
        <div class="backdrop-blur-xl bg-white/[0.06] rounded-xl border border-white/10 p-4 text-center card-hover">
          <p class="text-2xl font-heading font-bold text-white">{songCount}</p>
          <p class="text-xs text-white/40 mt-1">原创歌曲</p>
        </div>
        <div class="backdrop-blur-xl bg-white/[0.06] rounded-xl border border-white/10 p-4 text-center card-hover">
          <p class="text-2xl font-heading font-bold text-white">{awardWon}</p>
          <p class="text-xs text-white/40 mt-1">获奖荣誉</p>
        </div>
        <div class="backdrop-blur-xl bg-white/[0.06] rounded-xl border border-white/10 p-4 text-center card-hover">
          <p class="text-2xl font-heading font-bold text-white">{allEvents.length}</p>
          <p class="text-xs text-white/40 mt-1">演出活动</p>
        </div>
      </div>

      <div class="flex flex-wrap gap-4 mt-10">
        {SOCIAL_LINKS.map((link) => (
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm text-white/40 hover:text-white/70 transition-colors"
          >
            {link.name}
          </a>
        ))}
      </div>
    </div>
  </Container>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-white/30">
      <path d="M12 5v14M5 12l7 7 7-7" />
    </svg>
  </div>
</section>

<style is:global>
  @keyframes hb {
    0%, 100% { transform: translate(0, 0) scale(1); }
    25% { transform: translate(40px, -40px) scale(1.05); }
    50% { transform: translate(-30px, 30px) scale(0.95); }
    75% { transform: translate(30px, 40px) scale(1.02); }
  }
  .animate-hb { animation: hb 20s ease-in-out infinite; }
  .animation-delay-2 { animation-delay: 5s; }
  .animation-delay-4 { animation-delay: 15s; }

  @keyframes hr {
    0% { transform: scale(0.6); opacity: 0; }
    15% { opacity: 1; }
    100% { transform: scale(1.25); opacity: 0; }
  }
  .animate-hr { animation: hr 5s ease-out infinite; }

  @keyframes hn {
    0%, 100% { transform: translateY(0) rotate(0deg); opacity: 0.04; }
    50% { transform: translateY(-18px) rotate(8deg); opacity: 0.08; }
  }
  .animate-hn { animation: hn 8s ease-in-out infinite; }
</style>
