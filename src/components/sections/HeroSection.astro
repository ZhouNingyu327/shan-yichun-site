---
import { SITE, SOCIAL_LINKS } from '@/utils/constants';
import Container from '@/components/ui/Container.astro';
import { getCollection } from 'astro:content';

const music = (await getCollection('discography'))
  .sort((a, b) => new Date(b.data.releaseDate).getTime() - new Date(a.data.releaseDate).getTime());
const events = await getCollection('events');
const news = (await getCollection('news')).filter((item) => item.data.publicationStatus === 'published');
const latestRelease = music[0];
const [coverStart, coverEnd] = latestRelease?.data.coverColor?.split('-') ?? ['#7256e8', '#1f1641'];
const verifiedNews = news.filter((item) => item.data.verificationStatus === 'verified').length;
---

<section class="hero-shell relative overflow-hidden bg-[#090914] text-white">
  <div class="hero-grid absolute inset-0 opacity-40"></div>
  <div class="absolute -left-32 top-8 h-96 w-96 rounded-full bg-primary-500/20 blur-[130px]"></div>
  <div class="absolute -right-24 bottom-0 h-80 w-80 rounded-full bg-accent-500/15 blur-[130px]"></div>

  <Container class="relative z-10 py-16 sm:py-24 lg:py-28">
    <div class="grid items-center gap-12 lg:grid-cols-[1.08fr_0.92fr] lg:gap-16">
      <div>
        <p class="mb-5 text-[11px] font-semibold tracking-[0.28em] text-primary-200/80 uppercase">Shan Yichun · Archive</p>
        <h1 class="max-w-3xl text-5xl font-heading font-bold leading-[1.08] tracking-tight sm:text-7xl lg:text-8xl">{SITE.name}</h1>
        <p class="mt-5 max-w-xl text-lg font-light leading-8 text-white/65 sm:text-xl">{SITE.tagline}</p>
        <p class="mt-5 max-w-xl text-sm leading-7 text-white/45 sm:text-base">一个持续整理音乐、舞台与公开动态的非官方资料站。每一条新闻都有来源状态，让热爱也经得起回看。</p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/music" class="inline-flex items-center gap-2 rounded-full bg-white px-6 py-3 text-sm font-semibold text-[#171124] transition hover:bg-primary-100">浏览音乐档案 <span aria-hidden="true">↗</span></a>
          <a href="/news" class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/[0.06] px-6 py-3 text-sm font-medium text-white/85 transition hover:bg-white/[0.12]">查看动态来源 <span aria-hidden="true">→</span></a>
        </div>

        <dl class="mt-12 grid max-w-xl grid-cols-3 divide-x divide-white/10 border-y border-white/10 py-4">
          <div class="px-4 first:pl-0"><dt class="text-[11px] tracking-wide text-white/40">收录作品</dt><dd class="mt-1 text-2xl font-heading font-bold text-white">{music.length}</dd></div>
          <div class="px-4"><dt class="text-[11px] tracking-wide text-white/40">舞台与演出</dt><dd class="mt-1 text-2xl font-heading font-bold text-white">{events.length}</dd></div>
          <div class="px-4"><dt class="text-[11px] tracking-wide text-white/40">核验动态</dt><dd class="mt-1 text-2xl font-heading font-bold text-white">{verifiedNews}</dd></div>
        </dl>

        <div class="mt-7 flex flex-wrap gap-x-5 gap-y-2">
          {SOCIAL_LINKS.map((link) => (
            <a href={link.url} target="_blank" rel="noopener noreferrer" class="text-xs text-white/45 transition hover:text-primary-200">{link.name}<span class="ml-1 text-white/25" aria-hidden="true">↗</span></a>
          ))}
        </div>
      </div>

      {latestRelease && (
        <a href={`/music/${latestRelease.id}`} class="group relative mx-auto block w-full max-w-md">
          <div class="absolute inset-6 rounded-[2.25rem] bg-primary-500/30 blur-3xl transition duration-500 group-hover:bg-accent-500/30"></div>
          <article class="relative overflow-hidden rounded-[2rem] border border-white/15 bg-[#151224]/80 p-4 shadow-2xl backdrop-blur-xl sm:p-5">
            <div class="relative aspect-[4/5] overflow-hidden rounded-[1.5rem]" style={`background: linear-gradient(145deg, ${coverStart}, ${coverEnd})`}>
              <img src={`/images/covers/${latestRelease.id}.jpg`} alt={`${latestRelease.data.title} 封面`} class="h-full w-full object-cover transition duration-700 group-hover:scale-105" loading="eager" onerror="this.style.display='none'" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-transparent to-transparent"></div>
              <span class="absolute left-4 top-4 rounded-full border border-white/20 bg-black/25 px-3 py-1 text-[10px] font-medium tracking-[0.16em] text-white/80 backdrop-blur">LATEST RELEASE</span>
              <div class="absolute inset-x-5 bottom-5">
                <p class="text-xs text-white/55">{new Date(latestRelease.data.releaseDate).getFullYear()} · {latestRelease.data.type === 'album' ? '专辑' : latestRelease.data.type === 'ost' ? '影视原声' : '单曲'}</p>
                <h2 class="mt-1 text-3xl font-heading font-bold text-white">{latestRelease.data.title}</h2>
              </div>
            </div>
            <div class="flex items-center justify-between px-2 pb-1 pt-4"><p class="text-xs text-white/45">从作品进入完整资料</p><span class="grid h-8 w-8 place-items-center rounded-full border border-white/15 text-sm text-white/80 transition group-hover:bg-white group-hover:text-[#171124]" aria-hidden="true">↗</span></div>
          </article>
        </a>
      )}
    </div>
  </Container>
</section>

<style is:global>
  .hero-grid { background-image: linear-gradient(rgba(255,255,255,.035) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.035) 1px, transparent 1px); background-size: 40px 40px; mask-image: linear-gradient(to bottom, black, transparent 88%); }
</style>
