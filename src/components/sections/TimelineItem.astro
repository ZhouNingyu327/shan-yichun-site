---
export interface Props {
  year: string;
  title: string;
  align?: 'left' | 'right';
  accent?: boolean;
}
const { year, title, align = 'right', accent = false } = Astro.props;
const isRight = align === 'left';
---

<div class="timeline-item relative flex items-start gap-4 md:flex-row mb-10 md:mb-14 last:mb-0">
  <!-- 左侧：时间 -->
  <div class="hidden md:block w-1/2 text-right pr-8 pt-1">
    <span class="inline-block text-xs font-bold text-primary-600 bg-primary-50 px-2.5 py-0.5 rounded-full">{year}</span>
  </div>

  <!-- 圆点 -->
  <div class="relative flex-shrink-0 w-4 h-4 rounded-full border-2 mt-1 z-10"
    class:list={{ 'bg-primary-500 border-primary-500': accent, 'bg-white border-primary-300': !accent }}>
    <div class="absolute top-0 left-1/2 w-4 h-4 -translate-x-1/2">
      <div class="w-full h-full rounded-full" class:list={{ 'bg-primary-500': accent }} />
    </div>
  </div>

  <!-- 右侧：内容 -->
  <div class="md:w-1/2 pl-2 md:pl-8">
    <span class="md:hidden inline-block text-xs font-bold text-primary-600 bg-primary-50 px-2.5 py-0.5 rounded-full mb-2">{year}</span>
    <h3 class="text-base font-bold text-text-primary mb-1">{title}</h3>
    <p class="text-sm text-text-secondary leading-relaxed">
      <slot />
    </p>
  </div>
</div>
