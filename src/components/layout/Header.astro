---
import { NAV_ITEMS, SITE } from '@/utils/constants';
import MobileMenu from './MobileMenu.astro';
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-[#0c0b16]/85 text-white backdrop-blur-xl">
  <nav class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 group">
        <span class="text-xl sm:text-2xl font-heading font-bold text-white group-hover:text-primary-200 transition-colors">
          {SITE.name}
        </span>
        <span class="hidden sm:inline text-[11px] text-white/40 font-light tracking-[0.14em] uppercase">
          · Archive
        </span>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center gap-1">
        {
          NAV_ITEMS.map((item) => (
            <a
              href={item.href}
              class="px-3 py-2 text-sm font-medium text-white/55 hover:text-white hover:bg-white/[0.07] rounded-lg transition-colors"
            >
              {item.label}
            </a>
          ))
        }
      </div>

      <!-- Mobile Menu Button -->
      <MobileMenu />
    </div>
  </nav>
</header>
