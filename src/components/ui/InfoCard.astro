---
export interface Props {
  label: string;
  value: string;
}
const { label, value } = Astro.props;
---

<div class="bg-white rounded-xl border border-primary-100/30 p-4 card-hover">
  <p class="text-xs font-medium text-text-secondary/60 uppercase tracking-wider mb-1">{label}</p>
  <p class="text-sm font-semibold text-text-primary">{value}</p>
</div>
