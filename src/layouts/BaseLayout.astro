---
import '@/styles/global.css';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import BaseSEO from '@/components/seo/BaseSEO.astro';
import { SITE } from '@/utils/constants';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  path?: string;
}

const { title, description, image, path } = Astro.props;
const canonicalPath = path || Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <BaseSEO
      title={title}
      description={description || SITE.description}
      image={image}
      path={canonicalPath}
    />
    <!-- Preconnect for Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@300;400;500;700&family=Noto+Serif+SC:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen flex flex-col">
    <!-- 网站进入动画（仅首次访问） -->
    <div id="splash-screen" class="fixed inset-0 z-[9999] flex flex-col items-center justify-center overflow-hidden bg-[#0a0a1a]">
      <!-- 背景图片轮播 - 完整显示不裁切 -->
      <div class="absolute inset-0 flex items-center justify-center bg-[#0a0a1a]">
        <img src="/images/封面图1.jpg" class="splash-bg absolute w-full h-full object-contain" style="max-width:100%;max-height:100%" data-index="0" />
        <img src="/images/封面图2.jpg" class="splash-bg absolute w-full h-full object-contain opacity-0" style="max-width:100%;max-height:100%" data-index="1" />
        <img src="/images/封面图3.jpg" class="splash-bg absolute w-full h-full object-contain opacity-0" style="max-width:100%;max-height:100%" data-index="2" />
        <img src="/images/封面图2.jpg" class="splash-bg absolute inset-0 w-full h-full object-cover opacity-0" data-index="1" />
        <img src="/images/封面图3.jpg" class="splash-bg absolute inset-0 w-full h-full object-cover opacity-0" data-index="2" />
      </div>
      <!-- 遮罩层 -->
      <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/40 to-black/70" />

      <!-- 声波环 -->
      <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
        <div class="relative w-80 aspect-square flex items-center justify-center">
          <div class="absolute inset-0 rounded-full border border-white/[0.06] animate-splash-ring" style="animation-duration: 3s" />
          <div class="absolute inset-[-20px] rounded-full border border-white/[0.04] animate-splash-ring" style="animation-duration: 4s; animation-delay: 0.5s" />
          <div class="absolute inset-[-40px] rounded-full border border-white/[0.03] animate-splash-ring" style="animation-duration: 5s; animation-delay: 1s" />
        </div>
      </div>

      <!-- 中心内容 -->
      <div class="relative z-10 text-center animate-splash-content">
        <p class="text-sm tracking-[0.5em] text-white/40 font-light mb-4 animate-splash-fade-in" style="animation-delay: 0.2s">SHAN YICHUN</p>
        <h1 class="text-6xl sm:text-8xl font-heading font-bold text-white drop-shadow-lg animate-splash-fade-in" style="animation-delay: 0.4s">
          单依纯
        </h1>
        <div class="mx-auto mt-5 h-px w-0 bg-gradient-to-r from-transparent via-white/40 to-transparent animate-splash-line" />
        <p class="mt-5 text-sm text-white/50 font-light tracking-widest animate-splash-fade-in" style="animation-delay: 0.8s">只有音乐和真心最重要</p>
        <div class="mt-6 flex justify-center gap-3 text-white/30 text-lg animate-splash-fade-in" style="animation-delay: 1s">
          <span class="animate-splash-note" style="animation-delay: 1.2s">♪</span>
          <span class="animate-splash-note" style="animation-delay: 1.5s">♫</span>
          <span class="animate-splash-note" style="animation-delay: 1.8s">♩</span>
          <span class="animate-splash-note" style="animation-delay: 2.1s">♬</span>
        </div>
      </div>

      <!-- 底部加载指示 -->
      <div class="absolute bottom-12 left-1/2 -translate-x-1/2 z-10 animate-splash-fade-in" style="animation-delay: 1.5s">
        <div class="w-8 h-8 rounded-full border-2 border-white/15 border-t-white/40 animate-spin" />
      </div>
    </div>

    <script is:inline>
      (function() {
        var splash = document.getElementById('splash-screen');
        if (splash && sessionStorage.getItem('splashShown')) {
          splash.style.display = 'none';
          return;
        }

        // 背景轮播：每3秒切换一张（缓慢交叉淡入淡出）
        var currentBg = 0;
        var bgImages = splash.querySelectorAll('.splash-bg');
        if (bgImages.length > 1) {
          setInterval(function() {
            bgImages.forEach(function(img) { img.classList.remove('opacity-100'); img.classList.add('opacity-0'); });
            currentBg = (currentBg + 1) % bgImages.length;
            bgImages[currentBg].classList.remove('opacity-0');
            bgImages[currentBg].classList.add('opacity-100');
          }, 3000);
        }

        if (splash) {
          var minShow = 6000;  // 最少显示6秒
          var start = Date.now();
          window.addEventListener('load', function() {
            var elapsed = Date.now() - start;
            var remaining = Math.max(0, minShow - elapsed);
            setTimeout(function() {
              splash.style.transition = 'opacity 0.8s ease, transform 0.8s ease';
              splash.style.opacity = '0';
              splash.style.transform = 'scale(1.05)';
              setTimeout(function() {
                splash.style.display = 'none';
                try { sessionStorage.setItem('splashShown', '1'); } catch(e) {}
              }, 800);
            }, remaining);
          });
          setTimeout(function() {
            if (splash.style.display !== 'none') {
              splash.style.transition = 'opacity 0.6s ease';
              splash.style.opacity = '0';
              setTimeout(function() { splash.style.display = 'none'; }, 600);
            }
          }, 8000);
        }
      })();
    </script>

    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
