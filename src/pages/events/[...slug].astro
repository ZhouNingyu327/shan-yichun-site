---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('events');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { data } = entry;

const typeLabels: Record<string, string> = {
  concert: '演唱会', variety: '综艺', award: '颁奖礼',
  interview: '采访', fanmeeting: '粉丝见面会', other: '活动',
};
const typeEmoji: Record<string, string> = {
  concert: '🎤', variety: '📺', award: '🏆',
  interview: '🎙️', fanmeeting: '💜', other: '🎬',
};
---

<BaseLayout title={data.title} path={`/events/${entry.id}`}>
  <div class="relative bg-gradient-to-br from-[#0a0a1a] via-[#120a2e] to-[#0f1923] overflow-hidden min-h-screen">
    <div class="fixed inset-0 overflow-hidden pointer-events-none">
      <div class="absolute top-[10%] left-[10%] w-[25rem] h-[25rem] rounded-full blur-[100px] opacity-20 animate-blob" style="background: linear-gradient(135deg, #8b5cf6, #7c3aed)" />
      <div class="absolute bottom-[20%] right-[10%] w-[20rem] h-[20rem] rounded-full blur-[100px] opacity-15 animate-blob animation-delay-2" style="background: linear-gradient(135deg, #ec4899, #f59e0b)" />
    </div>
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[80rem] h-px bg-gradient-to-r from-transparent via-white/15 to-transparent" />

    <Container class="relative z-10 py-16 sm:py-20">
      <div class="max-w-3xl mx-auto">
        <!-- 返回链接 -->
        <a href="/events" class="inline-flex items-center gap-1.5 text-sm text-white/40 hover:text-white/70 transition-colors mb-8">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          返回演出经历
        </a>

        <!-- 类型与精选标签 -->
        <div class="flex items-center gap-3 mb-4 flex-wrap">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-sm font-medium backdrop-blur-xl bg-white/10 text-white/70 border border-white/15">
            <span>{typeEmoji[data.type] || '🎬'}</span>
            {typeLabels[data.type] || data.type}
          </span>
          {data.featured && (
            <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-medium backdrop-blur-xl bg-amber-500/20 text-amber-200 border border-amber-400/20">
              ⭐ 精选活动
            </span>
          )}
        </div>

        <h1 class="text-3xl sm:text-4xl font-heading font-bold text-white mb-6">{data.title}</h1>

        <!-- 信息卡片 -->
        <div class="backdrop-blur-xl bg-white/[0.06] rounded-xl border border-white/10 p-5 sm:p-6 mb-8">
          <div class="grid sm:grid-cols-2 gap-4">
            <div class="flex items-center gap-3">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-primary-300 flex-shrink-0"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              <div>
                <p class="text-xs text-white/40 font-medium">日期</p>
                <p class="text-sm text-white/80">
                  {new Date(data.date).toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
                  {data.endDate ? ` — ${new Date(data.endDate).toLocaleDateString('zh-CN', { month: 'long', day: 'numeric' })}` : ''}
                </p>
              </div>
            </div>
            <div class="flex items-center gap-3">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-primary-300 flex-shrink-0"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              <div>
                <p class="text-xs text-white/40 font-medium">地点</p>
                <p class="text-sm text-white/80">{data.location}</p>
              </div>
            </div>
          </div>
        </div>

        <!-- 正文 -->
        <article class="text-white/60 leading-relaxed text-sm sm:text-base">
          <slot />
        </article>

        <!-- 相关链接 -->
        {data.links && data.links.length > 0 && (
          <div class="mt-8 backdrop-blur-xl bg-white/[0.06] rounded-xl border border-white/10 p-5">
            <h3 class="text-sm font-semibold text-white/80 mb-3">相关链接</h3>
            <ul class="space-y-2">
              {data.links.map((link) => (
                <li>
                  <a href={link.url} target="_blank" rel="noopener noreferrer" class="text-sm text-primary-300 hover:text-primary-200 transition-colors">
                    {link.label} →
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </Container>
  </div>
</BaseLayout>

<style is:global>
  @keyframes blob {
    0%, 100% { transform: translate(0, 0) scale(1); }
    25% { transform: translate(40px, -40px) scale(1.05); }
    50% { transform: translate(-30px, 30px) scale(0.95); }
    75% { transform: translate(30px, 40px) scale(1.02); }
  }
  .animate-blob { animation: blob 20s ease-in-out infinite; }
  .animation-delay-2 { animation-delay: 5s; }
</style>
