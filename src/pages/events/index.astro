---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import { getCollection } from 'astro:content';

const allEvents = (await getCollection('events'))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
const concerts = allEvents.filter(e => e.data.type === 'concert').sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
const nonConcerts = allEvents.filter(e => e.data.type !== 'concert');

const typeLabels: Record<string, string> = {
  concert: '演唱会', variety: '综艺', award: '颁奖礼',
  interview: '采访', fanmeeting: '粉丝见面会', other: '活动',
};
const typeEmoji: Record<string, string> = {
  concert: '🎤', variety: '📺', award: '🏆',
  interview: '🎙️', fanmeeting: '💜', other: '🎬',
};

const concertTypeColors: Record<string, string> = {
  concert: 'bg-primary-500/20 text-primary-300 border-primary-400/20',
  award: 'bg-amber-500/20 text-amber-200 border-amber-400/20',
  variety: 'bg-sky-500/20 text-sky-200 border-sky-400/20',
};

const grouped: Record<number, typeof allEvents> = {};
for (const event of allEvents) {
  const year = new Date(event.data.date).getFullYear();
  if (!grouped[year]) grouped[year] = [];
  grouped[year].push(event);
}

// Tour grouping for concerts
const tourGroups: Record<string, typeof concerts> = {};
for (const c of concerts) {
  const tour = c.data.tour || '其他';
  if (!tourGroups[tour]) tourGroups[tour] = [];
  tourGroups[tour].push(c);
}
---

<BaseLayout title="演出经历" path="/events">
  <div class="relative bg-gradient-to-br from-[#0a0a1a] via-[#120a2e] to-[#0f1923] overflow-hidden min-h-screen">
    <div class="fixed inset-0 overflow-hidden pointer-events-none">
      <div class="absolute top-[-10%] left-[-5%] w-[35rem] h-[35rem] rounded-full blur-[120px] opacity-25 animate-blob" style="background: linear-gradient(135deg, #8b5cf6, #ec4899)" />
      <div class="absolute bottom-[-15%] right-[-5%] w-[30rem] h-[30rem] rounded-full blur-[120px] opacity-20 animate-blob animation-delay-2" style="background: linear-gradient(135deg, #06b6d4, #8b5cf6)" />
      <div class="absolute top-[30%] right-[15%] w-[20rem] h-[20rem] rounded-full blur-[100px] opacity-15 animate-blob animation-delay-4" style="background: linear-gradient(135deg, #f59e0b, #ef4444)" />
    </div>
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[80rem] h-px bg-gradient-to-r from-transparent via-white/15 to-transparent" />

    <Container class="relative z-10 py-16 sm:py-20">
      <!-- 页面头部 -->
      <div class="text-center mb-10">
        <h1 class="text-4xl sm:text-5xl font-heading font-bold text-white mb-3">演出经历</h1>
        <p class="text-white/50">从好声音冠军到万人巡演 · 共 {allEvents.length} 场活动</p>
        <div class="mx-auto mt-4 w-16 h-[2px] bg-gradient-to-r from-primary-400/60 to-accent-400/60 rounded-full" />
      </div>

      <!-- Tab 切换 -->
      <div class="flex justify-center gap-2 mb-10">
        <button id="tab-all" class="tab-btn px-5 py-2 rounded-full text-sm font-medium transition-all backdrop-blur-xl bg-white/15 text-white border border-white/20">全部 {allEvents.length}</button>
        <button id="tab-concerts" class="tab-btn px-5 py-2 rounded-full text-sm font-medium transition-all backdrop-blur-xl bg-white/5 text-white/50 border border-white/5 hover:bg-white/10">🎤 演唱会 {concerts.length}</button>
      </div>

      <!-- ===== 全部活动 ===== -->
      <div id="panel-all" class="tab-panel">
        <!-- 年份导航 -->
        <div class="flex flex-wrap justify-center gap-2 mb-10">
          {Object.keys(grouped).reverse().map((year) => (
            <a href={`#ey-${year}`} class="px-4 py-1.5 rounded-full text-sm font-medium transition-all backdrop-blur-xl bg-white/8 text-white/60 border border-white/10 hover:bg-white/15 hover:text-white">{year}年</a>
          ))}
        </div>
        {Object.entries(grouped).reverse().map(([year, events]) => (
          <section id={`ey-${year}`} class="mb-12 scroll-mt-20">
            <div class="flex items-center gap-4 mb-5">
              <span class="text-2xl font-heading font-bold text-white/90">{year}年</span>
              <div class="flex-1 h-px bg-gradient-to-r from-white/20 to-transparent" />
              <span class="text-sm text-white/40">{events.length} 场</span>
            </div>
            <div class="grid gap-3 sm:grid-cols-2">
              {events.map((event) => {
                const d = new Date(event.data.date);
                return (
                  <a href={`/events/${event.id}`} class="group block">
                    <div class="backdrop-blur-xl bg-white/[0.05] rounded-xl border border-white/10 p-4 card-hover h-full">
                      <div class="flex items-start gap-3">
                        <div class="text-center flex-shrink-0 w-12 pt-0.5">
                          <div class="text-lg font-bold text-primary-300 leading-none">{d.getDate()}</div>
                          <div class="text-[10px] text-white/40">{d.toLocaleDateString('zh-CN',{month:'short'}).replace('月','')}月</div>
                        </div>
                        <div class="flex-1 min-w-0">
                          <div class="flex items-center gap-1.5 flex-wrap">
                            <span>{typeEmoji[event.data.type]||'🎬'}</span>
                            <h3 class="text-sm font-semibold text-white/85 group-hover:text-primary-300 transition-colors line-clamp-1">{event.data.title}</h3>
                          </div>
                          <p class="text-xs text-white/45 mt-0.5">{event.data.location}{event.data.venue ? ` · ${event.data.venue}` : ''}</p>
                        </div>
                        <span class={`text-[10px] px-2 py-0.5 rounded-full font-medium flex-shrink-0 ${concertTypeColors[event.data.type]||'bg-white/10 text-white/50'}`}>
                          {typeLabels[event.data.type]||event.data.type}
                        </span>
                      </div>
                    </div>
                  </a>
                );
              })}
            </div>
          </section>
        ))}
      </div>

      <!-- ===== 演唱会专区 ===== -->
      <div id="panel-concerts" class="tab-panel hidden">
        <!-- Tour overview stats -->
        <div class="grid grid-cols-1 sm:grid-cols-4 gap-3 mb-10">
          <div class="backdrop-blur-xl bg-white/[0.06] rounded-xl border border-white/10 p-4 text-center">
            <p class="text-2xl font-heading font-bold text-white">{concerts.length}</p>
            <p class="text-xs text-white/40 mt-1">总场次</p>
          </div>
          <div class="backdrop-blur-xl bg-white/[0.06] rounded-xl border border-white/10 p-4 text-center">
            <p class="text-2xl font-heading font-bold text-white">3</p>
            <p class="text-xs text-white/40 mt-1">巡演轮次</p>
          </div>
          <div class="backdrop-blur-xl bg-white/[0.06] rounded-xl border border-white/10 p-4 text-center">
            <p class="text-2xl font-heading font-bold text-white">13</p>
            <p class="text-xs text-white/40 mt-1">到访城市</p>
          </div>
          <div class="backdrop-blur-xl bg-white/[0.06] rounded-xl border border-white/10 p-4 text-center">
            <p class="text-2xl font-heading font-bold text-white">~48万+</p>
            <p class="text-xs text-white/40 mt-1">累计观演人次</p>
          </div>
        </div>

        <!-- Tour sections -->
        {Object.entries(tourGroups).reverse().map(([tour, shows]) => {
          const firstDate = new Date(shows[shows.length-1].data.date);
          const lastDate = new Date(shows[0].data.date);
          const cities = [...new Set(shows.map(s => s.data.location.split('·').pop() || s.data.location))];
          const totalCap = shows.reduce((sum, s) => sum + (s.data.capacity || 0), 0);
          return (
            <section class="mb-12">
              <div class="backdrop-blur-xl bg-white/[0.06] rounded-2xl border border-white/10 p-6 mb-5">
                <div class="flex items-center justify-between flex-wrap gap-3">
                  <div>
                    <h2 class="text-xl font-heading font-bold text-white">{tour}</h2>
                    <p class="text-sm text-white/40 mt-1">
                      {firstDate.toLocaleDateString('zh-CN',{year:'numeric',month:'long',day:'numeric'})} — {lastDate.toLocaleDateString('zh-CN',{month:'long',day:'numeric'})}
                      · 共{shows.length}场 · {cities.length}城
                    </p>
                  </div>
                  <div class="text-right">
                    <p class="text-lg font-heading font-bold text-primary-300">{totalCap.toLocaleString()}+</p>
                    <p class="text-xs text-white/40">累计座位</p>
                  </div>
                </div>
                <div class="flex flex-wrap gap-1.5 mt-3">
                  {cities.map(city => <span class="px-2.5 py-0.5 rounded-full bg-white/8 text-white/60 text-[11px] border border-white/10">{city}</span>)}
                </div>
              </div>
              <div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
                {shows.map((show) => {
                  const d = new Date(show.data.date);
                  return (
                    <a href={`/events/${show.id}`} class="group block">
                      <div class="backdrop-blur-xl bg-white/[0.04] rounded-xl border border-white/8 p-4 card-hover h-full">
                        <div class="flex items-center gap-3">
                          <div class="text-center flex-shrink-0">
                            <div class="text-sm font-bold text-primary-300 leading-none">{d.getDate()}</div>
                            <div class="text-[10px] text-white/40">{d.toLocaleDateString('zh-CN',{month:'short'})}</div>
                          </div>
                          <div class="flex-1 min-w-0">
                            <p class="text-sm font-semibold text-white/85">{show.data.location.split('·').pop() || show.data.location}</p>
                            <p class="text-[11px] text-white/40 truncate">{show.data.venue}</p>
                          </div>
                          {show.data.capacity && <span class="text-[10px] text-white/35">{show.data.capacity.toLocaleString()}座</span>}
                        </div>
                      </div>
                    </a>
                  );
                })}
              </div>
            </section>
          );
        })}

        <!-- 纯妹妹2.0 Setlist -->
        <section class="mb-10">
          <h2 class="text-xl font-heading font-bold text-white/90 mb-5 flex items-center gap-3">
            <span class="w-1 h-7 bg-primary-400 rounded-full inline-block" /> 纯妹妹2.0 歌单
            <span class="text-sm font-normal text-white/40 font-body">· 各站歌曲对比</span>
          </h2>
          <div class="backdrop-blur-xl bg-white/[0.05] rounded-2xl border border-white/10 p-5 sm:p-6 overflow-x-auto">
            <table class="w-full text-sm whitespace-nowrap">
              <thead>
                <tr class="border-b border-white/10">
                  <th class="text-left text-white/50 font-medium px-3 py-2 text-xs">环节</th>
                  <th class="text-left text-white/50 font-medium px-3 py-2 text-xs">歌曲</th>
                  <th class="text-center text-white/50 font-medium px-2 py-2 text-[10px]">深圳<br/>3.28</th>
                  <th class="text-center text-white/50 font-medium px-2 py-2 text-[10px]">深圳<br/>3.29</th>
                  <th class="text-center text-white/50 font-medium px-2 py-2 text-[10px]">武汉<br/>4.10</th>
                  <th class="text-center text-white/50 font-medium px-2 py-2 text-[10px]">武汉<br/>4.11-12</th>
                  <th class="text-center text-white/50 font-medium px-2 py-2 text-[10px]">郑州<br/>4.25-26</th>
                  <th class="text-center text-white/50 font-medium px-2 py-2 text-[10px]">大连<br/>5.16-17</th>
                  <th class="text-center text-white/50 font-medium px-2 py-2 text-[10px]">厦门<br/>6.13</th>
                  <th class="text-center text-white/50 font-medium px-2 py-2 text-[10px]">广州<br/>6.27-28</th>
                  <th class="text-center text-white/50 font-medium px-2 py-2 text-[10px]">上海<br/>7.17</th>
                  <th class="text-center text-white/50 font-medium px-2 py-2 text-[10px]">上海<br/>7.18-19</th>
                </tr>
              </thead>
              <tbody>
                {[
                  {part: 'Part.1', songs: ['七彩光','多少的光阴','珠玉','有趣','好想谈恋爱','我表示理解']},
                  {part: 'Part.2', songs: ['向日葵朝着夜','还有什么更好的','我管不住我自己','爱里','像烟火爱过','爱我的时候','纤维','天空']},
                  {part: 'Part.3', songs: ['纯寐寐','TENDER','一个人跳舞','空耳','还你茉莉']},
                  {part: 'Part.4', songs: ['君','假如我们还爱着','在夜里跳舞','照片','想你时风起']},
                  {part: 'Encore', songs: ['Dear friend','光波','另一种答案']},
                ].map((part) => part.songs.map((song, si) => {
                  const isNew = song === '舞娘' || song === '李白' || song === '轻轻地告诉你' || song === '橄榄树';
                  const hasVariation = song === '好想谈恋爱' || song === '我表示理解' || song === '爱里' || song === '像烟火爱过' || song === '纤维' || song === '在夜里跳舞' || song === '空耳';
                  const sz29only = song === '轻轻地告诉你' || song === '李白' || song === '舞娘';
                  return (
                    <tr class="border-b border-white/5 hover:bg-white/[0.02] transition-colors">
                      {si === 0 && <td class="text-white/30 text-[10px] px-3 py-2.5 align-top font-medium" rowspan={part.songs.length}>{part.part}</td>}
                      <td class="text-white/70 text-xs px-3 py-2.5">{song}{isNew ? <span class="text-[9px] text-accent-300/60 ml-1">*</span> : ''}</td>
                      <td class="text-center px-2 py-2.5 text-white/60">{'●'}</td>
                      <td class="text-center px-2 py-2.5 text-white/60">{sz29only ? '—' : '●'}</td>
                      <td class="text-center px-2 py-2.5 text-white/60">{'●'}</td>
                      <td class="text-center px-2 py-2.5 text-white/60">{'●'}</td>
                      <td class="text-center px-2 py-2.5 text-white/60">{'●'}</td>
                      <td class="text-center px-2 py-2.5 text-white/60">{'●'}</td>
                      <td class="text-center px-2 py-2.5 text-white/60">{'●'}</td>
                      <td class="text-center px-2 py-2.5 text-white/60">{'●'}</td>
                      <td class="text-center px-2 py-2.5 text-white/60">{'●'}</td>
                      <td class="text-center px-2 py-2.5 text-white/60">{'●'}</td>
                    </tr>
                  );
                }))}
              </tbody>
            </table>
            <div class="mt-3 text-[10px] text-white/30 flex gap-4">
              <span>* 为限定场次新增曲</span>
              <span>O 飞岛舞台（受顶棚限制）</span>
            </div>
          </div>
        </section>
      </div>
    </Container>
  </div>
</BaseLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    var tabAll = document.getElementById('tab-all');
    var tabConcerts = document.getElementById('tab-concerts');
    var panelAll = document.getElementById('panel-all');
    var panelConcerts = document.getElementById('panel-concerts');
    if (tabAll && tabConcerts) {
      function switchTab(tab) {
        tabAll.className = 'tab-btn px-5 py-2 rounded-full text-sm font-medium transition-all backdrop-blur-xl ' + (tab === 'all' ? 'bg-white/15 text-white border border-white/20' : 'bg-white/5 text-white/50 border border-white/5 hover:bg-white/10');
        tabConcerts.className = 'tab-btn px-5 py-2 rounded-full text-sm font-medium transition-all backdrop-blur-xl ' + (tab === 'concerts' ? 'bg-white/15 text-white border border-white/20' : 'bg-white/5 text-white/50 border border-white/5 hover:bg-white/10');
        panelAll.classList.toggle('hidden', tab !== 'all');
        panelConcerts.classList.toggle('hidden', tab !== 'concerts');
      }
      tabAll.addEventListener('click', function() { switchTab('all'); });
      tabConcerts.addEventListener('click', function() { switchTab('concerts'); });
    }
  });
</script>

<style is:global>
  @keyframes blob {
    0%, 100% { transform: translate(0, 0) scale(1); }
    25% { transform: translate(40px, -40px) scale(1.05); }
    50% { transform: translate(-30px, 30px) scale(0.95); }
    75% { transform: translate(30px, 40px) scale(1.02); }
  }
  .animate-blob { animation: blob 20s ease-in-out infinite; }
  .animation-delay-2 { animation-delay: 5s; }
  .animation-delay-4 { animation-delay: 15s; }
  html { scroll-behavior: smooth; }
</style>
