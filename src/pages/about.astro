<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    // Scroll reveal
    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) {
          e.target.classList.add('opacity-100', 'translate-y-0');
          e.target.classList.remove('opacity-0', 'translate-y-4');
        }
      });
    }, { threshold: 0.1 });
    document.querySelectorAll('.tl-item').forEach(function (el) {
      el.classList.add('opacity-0', 'translate-y-4', 'transition-all', 'duration-700', 'ease-out');
      observer.observe(el);
    });

    // Timeline accordion
    document.querySelectorAll('.tl-toggle').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var body = btn.nextElementSibling;
        body.classList.toggle('open');
        btn.querySelector('.tl-arrow').classList.toggle('rotate-180');
        if (body.classList.contains('open')) {
          body.style.maxHeight = body.scrollHeight + 80 + 'px';
        } else {
          body.style.maxHeight = '0';
        }
      });
    });

    // Waveform animation on hover
    document.querySelectorAll('.waveform-card').forEach(function (card) {
      card.addEventListener('mouseenter', function () {
        card.querySelectorAll('.wf-bar').forEach(function (bar, i) {
          var h = 4 + Math.random() * 16;
          bar.style.setProperty('--h', h + 'px');
          bar.style.animation = 'wavePulse 0.6s ease-in-out ' + (i * 0.08) + 's infinite alternate';
        });
      });
      card.addEventListener('mouseleave', function () {
        card.querySelectorAll('.wf-bar').forEach(function (bar) {
          bar.style.animation = 'none';
          bar.style.height = '4px';
        });
      });
    });

    // Stat counter animation
    document.querySelectorAll('.stat-num').forEach(function (el) {
      var target = parseInt(el.textContent);
      if (isNaN(target) || target > 999) return;
      var current = 0;
      var step = Math.max(1, Math.floor(target / 30));
      var timer = setInterval(function () {
        current += step;
        if (current >= target) { current = target; clearInterval(timer); }
        el.textContent = current;
      }, 40);
    });
  });
</script>

<style is:global>
  @keyframes wavePulse {
    0% { height: 4px; }
    100% { height: var(--h, 20px); }
  }
  @keyframes slowFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }
  .float-anim { animation: slowFloat 6s ease-in-out infinite; }
  .float-anim:nth-child(2) { animation-delay: 1s; }
  .float-anim:nth-child(3) { animation-delay: 2s; }

  .tl-body {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s ease;
  }
  .tl-body.open { max-height: 500px !important; }

  .bar-glow:hover { filter: brightness(1.15); transition: filter 0.2s; }
</style>
