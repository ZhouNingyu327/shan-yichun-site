---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import InfoCard from '@/components/ui/InfoCard.astro';
import TimelineItem from '@/components/sections/TimelineItem.astro';
import { SOCIAL_LINKS } from '@/utils/constants';
import { getCollection } from 'astro:content';

const bioEntries = await getCollection('biography');
const bio = bioEntries[0];

// Gather stats dynamically from content collections
const allMusic = await getCollection('discography');
const allAwards = await getCollection('awards');
const allEvents = await getCollection('events');
const albumCount = allMusic.filter((m) => m.data.type === 'album').length;
const songCount = allMusic.length;
const awardCount = allAwards.filter((a) => a.data.result === 'won').length;
const eventCount = allEvents.length;

// Get featured discography for "代表作" section
const featured = allMusic.filter((m) => m.id === 'xiang-ni-shi-feng-qi' || m.id === 'yong-gan-e-du' || m.id === 'chun-mei-mei' || m.id === 'xu-xie' || m.id === 'ni-de-zhen-cang' || m.id === 'yi-sheng-yi-nian');
---

<BaseLayout title="个人简介" path="/about">
  <!-- ===== HERO ===== -->
  <section class="relative bg-gradient-to-br from-primary-700 via-primary-500 to-accent-600 py-16 sm:py-24 overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute -top-20 -left-20 w-80 h-80 bg-white rounded-full blur-3xl" />
      <div class="absolute -bottom-20 -right-20 w-96 h-96 bg-white rounded-full blur-3xl" />
      <div class="absolute top-1/2 left-1/3 w-48 h-48 bg-accent-200 rounded-full blur-3xl" />
    </div>
    <Container class="relative z-10">
      <div class="flex flex-col md:flex-row items-center gap-8 md:gap-16 mb-10">
        <div class="w-36 h-36 sm:w-44 sm:h-44 rounded-full bg-white/10 backdrop-blur-md border-2 border-white/20 flex items-center justify-center flex-shrink-0 shadow-2xl overflow-hidden">
          <div class="text-center">
            <span class="text-white/30 text-5xl font-heading font-bold">SYC</span>
          </div>
        </div>
        <div class="text-center md:text-left">
          <div class="flex items-center gap-3 justify-center md:justify-start mb-2">
            <h1 class="text-4xl sm:text-5xl font-heading font-bold text-white">单依纯</h1>
            <span class="px-2.5 py-0.5 rounded-full bg-white/15 text-white/80 text-xs font-medium border border-white/10">00后</span>
          </div>
          <p class="text-lg text-white/70 font-light tracking-wide">Shan Yichun</p>
          <p class="mt-3 text-white/85 text-sm sm:text-base max-w-2xl leading-relaxed">
            中国内地流行乐女歌手 · 2020年《中国好声音》全国总冠军 · 第37届金曲奖最佳华语女歌手提名
          </p>
          <div class="flex flex-wrap gap-2 mt-4 justify-center md:justify-start">
            {SOCIAL_LINKS.map((link) => (
              <a href={link.url} target="_blank" rel="noopener noreferrer"
                class="px-3.5 py-1 rounded-full bg-white/10 text-white/75 border border-white/15 text-xs hover:bg-white/20 hover:text-white transition-all">
                {link.name}
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- 数据仪表板 -->
      <div class="grid grid-cols-2 sm:grid-cols-5 gap-3">
        <div class="bg-white/10 backdrop-blur-sm rounded-xl border border-white/10 p-4 text-center">
          <p class="text-2xl sm:text-3xl font-heading font-bold text-white">{songCount}</p>
          <p class="text-xs text-white/60 mt-1">原创歌曲</p>
        </div>
        <div class="bg-white/10 backdrop-blur-sm rounded-xl border border-white/10 p-4 text-center">
          <p class="text-2xl sm:text-3xl font-heading font-bold text-white">{albumCount}</p>
          <p class="text-xs text-white/60 mt-1">录音室专辑</p>
        </div>
        <div class="bg-white/10 backdrop-blur-sm rounded-xl border border-white/10 p-4 text-center">
          <p class="text-2xl sm:text-3xl font-heading font-bold text-white">{awardCount}</p>
          <p class="text-xs text-white/60 mt-1">获奖荣誉</p>
        </div>
        <div class="bg-white/10 backdrop-blur-sm rounded-xl border border-white/10 p-4 text-center">
          <p class="text-2xl sm:text-3xl font-heading font-bold text-white">{Math.max(0, 2026 - 2020)}</p>
          <p class="text-xs text-white/60 mt-1">出道年数</p>
        </div>
        <div class="bg-white/10 backdrop-blur-sm rounded-xl border border-white/10 p-4 text-center">
          <p class="text-2xl sm:text-3xl font-heading font-bold text-white">{allEvents.length}</p>
          <p class="text-xs text-white/60 mt-1">演出活动</p>
        </div>
      </div>
    </Container>
  </section>

  <Container class="py-10 sm:py-14">
    <!-- ===== 基本信息 ===== -->
    <section class="mb-14">
      <h2 class="text-xl sm:text-2xl font-heading font-bold text-text-primary mb-6 flex items-center gap-3">
        <span class="w-1 h-7 bg-primary-500 rounded-full inline-block" /> 基本信息
      </h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-3">
        <InfoCard label="中文名" value="单依纯" />
        <InfoCard label="英文名" value="Shan Yichun" />
        <InfoCard label="国籍" value="中国" />
        <InfoCard label="出生" value="2001.12.23 · 东阳" />
        <InfoCard label="职业" value="歌手" />
        <InfoCard label="毕业院校" value="浙江音乐学院" />
        <InfoCard label="经纪公司" value="自来卷音乐工作室" />
        <InfoCard label="身高" value="168cm" />
        <InfoCard label="粉丝名" value="纯牛奶" />
        <InfoCard label="导师" value="李健" />
        <InfoCard label="擅长风格" value="流行 / R&B" />
        <InfoCard label="个人工作室" value="2025.12 成立" />
      </div>
    </section>

    <!-- ===== 早年经历 ===== 三段式卡片化 -->
    <section class="mb-14">
      <h2 class="text-xl sm:text-2xl font-heading font-bold text-text-primary mb-6 flex items-center gap-3">
        <span class="w-1 h-7 bg-primary-500 rounded-full inline-block" /> 早年经历
      </h2>
      <div class="grid sm:grid-cols-3 gap-4">
        <div class="bg-white rounded-2xl border border-primary-100/30 p-5 card-hover">
          <div class="w-10 h-10 rounded-full bg-primary-100 flex items-center justify-center mb-3">
            <span class="text-lg">🎵</span>
          </div>
          <h3 class="text-sm font-bold text-text-primary mb-2">🎤 音乐启蒙</h3>
          <p class="text-xs text-text-secondary leading-relaxed">
            出生于浙江东阳普通家庭。母亲单梅芳喜欢越剧，受母亲影响从小热爱音乐。小学三年级开始学声乐，多次在东阳市童声大赛中获奖，六年级时演唱的《山里的阳光》被选为校歌。
          </p>
        </div>
        <div class="bg-white rounded-2xl border border-primary-100/30 p-5 card-hover">
          <div class="w-10 h-10 rounded-full bg-primary-100 flex items-center justify-center mb-3">
            <span class="text-lg">⭐</span>
          </div>
          <h3 class="text-sm font-bold text-text-primary mb-2">🌟 梦想萌芽</h3>
          <p class="text-xs text-text-secondary leading-relaxed">
            初中开始在唱歌软件上发布作品积累粉丝。2018年通过"全民K歌"从150多万应征者中被选中，参加湖南卫视《我想和你唱》，与李健合唱《绒花》。这次经历让她坚定了走音乐道路的决心。
          </p>
        </div>
        <div class="bg-white rounded-2xl border border-primary-100/30 p-5 card-hover">
          <div class="w-10 h-10 rounded-full bg-primary-100 flex items-center justify-center mb-3">
            <span class="text-lg">🎓</span>
          </div>
          <h3 class="text-sm font-bold text-text-primary mb-2">🎶 艺考之路</h3>
          <p class="text-xs text-text-secondary leading-relaxed">
            高二决定走音乐道路开始专业学习。高三参加艺考培训班。2020年以专业第一名的成绩考入浙江音乐学院流行音乐系（2024年7月毕业），师从音乐人王滔。学习音乐的费用靠父母贷款支持。
          </p>
        </div>
      </div>
    </section>

    <!-- ===== 时间线 ===== -->
    <section class="mb-14">
      <h2 class="text-xl sm:text-2xl font-heading font-bold text-text-primary mb-10 flex items-center gap-3">
        <span class="w-1 h-7 bg-primary-500 rounded-full inline-block" /> 演艺经历
      </h2>

      <div class="relative max-w-4xl mx-auto">
        <div class="absolute left-4 md:left-1/2 top-0 bottom-0 w-px bg-primary-200 transform md:-translate-x-px" />

        <TimelineItem year="2020" title="《中国好声音》夺冠出道" align="right" accent>
          参加《中国好声音2020》，盲选演唱《永不失联的爱》刷屏，获四位导师转身，加入李健战队。11月20日决赛夺得全国总冠军，正式出道。签约百沐娱乐，为张艺谋电影《一秒钟》演唱推广曲，发行首支个人单曲《照片》。
        </TimelineItem>

        <TimelineItem year="2021" title="崭露头角 · 多档综艺" align="left">
          发行《在夜里跳舞》《分身》《喂》等单曲。为《一生一世》演唱主题曲《续写》，为《误杀2》演唱片尾曲《萤火虫》。常驻《说唱听我的2》《爆裂舞台》《我们的歌第三季》等综艺。获第三届TMEA"年度最具潜力歌手"奖。
        </TimelineItem>

        <TimelineItem year="2022" title="首张专辑《勇敢额度》" align="right" accent>
          1月2日发行首张个人专辑《勇敢额度》，收录10首歌曲含全英文歌《Tell Me》。出演电影《你是我的一束光》（荧幕首秀）。参加《声生不息·港乐季》发行首支粤语单曲《靓仔日记》。获第29届东方风云榜"最佳新锐歌手"奖。
          <div class="mt-3 flex items-center gap-2">
            <a href="/music/yong-gan-e-du" class="inline-flex items-center gap-1.5 text-xs text-primary-600 hover:text-primary-700 font-medium">
              <span class="w-6 h-6 rounded bg-gradient-to-br from-purple-600 to-indigo-600 inline-block flex-shrink-0" />
              收听专辑 →
            </a>
          </div>
        </TimelineItem>

        <TimelineItem year="2023" title="首登央视春晚 · 首次个唱" align="left" accent>
          首次登上央视春晚，与黄霄雲、宋轶等合唱《绿水青山》。为《三体》演唱插曲《让我随风》，为《我的人间烟火》演唱《想你时风起》（年度热门）。12月23日生日当天在杭州举办首次个人演唱会。获浪潮音乐大赏"最佳新人"奖。
          <div class="mt-3 flex items-center gap-2">
            <a href="/music/xiang-ni-shi-feng-qi" class="inline-flex items-center gap-1.5 text-xs text-primary-600 hover:text-primary-700 font-medium">
              <span class="w-6 h-6 rounded bg-gradient-to-br from-indigo-500 to-violet-500 inline-block flex-shrink-0" />
              《想你时风起》→
            </a>
          </div>
        </TimelineItem>

        <TimelineItem year="2024" title="再登春晚 · 连获大奖" align="right" accent>
          连续第二年登上央视春晚，与海来阿木合唱《不如见一面》。获TMEA"年度最佳内地女歌手"、东方风云榜"最受欢迎女歌手"。参加《音乐缘计划》创作《终身孤独》《TENDER》等多首作品。为第二张专辑蓄力。
        </TimelineItem>

        <TimelineItem year="2025" title="《歌手2025》· 二专《纯妹妹》" align="left" accent>
          以首发歌手参加《歌手2025》，两度获周冠军，总决赛第三名。8月获东方风云榜"最佳女歌手"。12月成立个人工作室。12月28日发行第二张专辑《纯妹妹》（常石磊制作，10首歌曲）。与周深合作全运会主题歌《天海一心》。
          <div class="mt-3 flex items-center gap-2">
            <a href="/music/chun-mei-mei" class="inline-flex items-center gap-1.5 text-xs text-primary-600 hover:text-primary-700 font-medium">
              <span class="w-6 h-6 rounded bg-gradient-to-br from-purple-600 to-indigo-600 inline-block flex-shrink-0" />
              收听专辑 →
            </a>
          </div>
        </TimelineItem>

        <TimelineItem year="2026" title="香奈儿大使 · 金曲奖提名" align="right" accent>
          1月香奈儿官宣品牌形象大使（首位00后华人歌手代言人）。「纯妹妹2.0」巡演开唱。5月凭借《纯妹妹》入围第37届金曲奖最佳华语女歌手。发行《光波》《我在意的》等单曲。
        </TimelineItem>
      </div>
    </section>

    <!-- ===== 代表作品 ===== -->
    <section class="mb-14">
      <h2 class="text-xl sm:text-2xl font-heading font-bold text-text-primary mb-6 flex items-center gap-3">
        <span class="w-1 h-7 bg-primary-500 rounded-full inline-block" /> 代表作品
      </h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-3">
        {featured.map((item) => {
          const [c1, c2] = item.data.coverColor ? item.data.coverColor.split('-') : ['#8b5cf6','#7c3aed'];
          return (
            <a href={`/music/${item.id}`} class="group block">
              <div class="bg-white rounded-xl border border-primary-100/30 overflow-hidden card-hover">
                <div class="aspect-square flex items-center justify-center" style={`background: linear-gradient(135deg, ${c1}, ${c2})`}>
                  <img src={`/images/covers/${item.id}.jpg`} alt={item.data.title} class="absolute inset-0 w-full h-full object-cover" loading="lazy" onerror="this.style.display='none'" />
                  <div class="absolute inset-0 bg-gradient-to-br from-black/20 to-transparent" />
                  <p class="relative z-10 text-white/90 text-xs font-heading font-bold px-2 text-center leading-tight">{item.data.title}</p>
                </div>
                <div class="p-2.5 text-center">
                  <p class="text-xs font-medium text-text-primary truncate group-hover:text-primary-600 transition-colors">{item.data.title}</p>
                  <p class="text-[10px] text-text-secondary/60">{item.data.type === 'album' ? '专辑' : item.data.type === 'ost' ? 'OST' : '单曲'}</p>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </section>

    <!-- ===== 高光时刻 ===== -->
    <section class="mb-14">
      <h2 class="text-xl sm:text-2xl font-heading font-bold text-text-primary mb-6 flex items-center gap-3">
        <span class="w-1 h-7 bg-primary-500 rounded-full inline-block" /> 演艺高光时刻
      </h2>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        <div class="bg-gradient-to-br from-primary-500 to-primary-700 rounded-xl aspect-[4/3] flex items-center justify-center relative overflow-hidden card-hover">
          <div class="absolute inset-0 bg-black/20" />
          <div class="relative z-10 text-center px-3">
            <p class="text-3xl mb-1">🏆</p>
            <p class="text-white/90 text-xs font-bold">好声音总冠军</p>
            <p class="text-white/60 text-[10px] mt-0.5">2020</p>
          </div>
        </div>
        <div class="bg-gradient-to-br from-accent-500 to-accent-700 rounded-xl aspect-[4/3] flex items-center justify-center relative overflow-hidden card-hover">
          <div class="absolute inset-0 bg-black/20" />
          <div class="relative z-10 text-center px-3">
            <p class="text-3xl mb-1">🎤</p>
            <p class="text-white/90 text-xs font-bold">央视春晚首秀</p>
            <p class="text-white/60 text-[10px] mt-0.5">2023</p>
          </div>
        </div>
        <div class="bg-gradient-to-br from-emerald-500 to-emerald-700 rounded-xl aspect-[4/3] flex items-center justify-center relative overflow-hidden card-hover">
          <div class="absolute inset-0 bg-black/20" />
          <div class="relative z-10 text-center px-3">
            <p class="text-3xl mb-1">🎪</p>
            <p class="text-white/90 text-xs font-bold">首次个人演唱会</p>
            <p class="text-white/60 text-[10px] mt-0.5">2023 · 杭州</p>
          </div>
        </div>
        <div class="bg-gradient-to-br from-amber-500 to-amber-700 rounded-xl aspect-[4/3] flex items-center justify-center relative overflow-hidden card-hover">
          <div class="absolute inset-0 bg-black/20" />
          <div class="relative z-10 text-center px-3">
            <p class="text-3xl mb-1">🎯</p>
            <p class="text-white/90 text-xs font-bold">金曲奖提名</p>
            <p class="text-white/60 text-[10px] mt-0.5">2026</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== 个人生活 ===== -->
    <section class="mb-14">
      <h2 class="text-xl sm:text-2xl font-heading font-bold text-text-primary mb-6 flex items-center gap-3">
        <span class="w-1 h-7 bg-primary-500 rounded-full inline-block" /> 个人生活
      </h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-3">
        <div class="bg-white rounded-xl border border-primary-100/30 p-4 card-hover">
          <div class="flex items-center gap-3 mb-3">
            <span class="text-2xl">💚</span>
            <p class="text-xs font-bold text-primary-600 uppercase tracking-wider">家庭</p>
          </div>
          <p class="text-sm text-text-secondary leading-relaxed">出身普通家庭，音乐费用靠父母贷款。母亲单梅芳喜欢越剧是其音乐启蒙。与恩师李健关系深厚。</p>
        </div>
        <div class="bg-white rounded-xl border border-primary-100/30 p-4 card-hover">
          <div class="flex items-center gap-3 mb-3">
            <span class="text-2xl">🧠</span>
            <p class="text-xs font-bold text-primary-600 uppercase tracking-wider">性格</p>
          </div>
          <p class="text-sm text-text-secondary leading-relaxed">自曝有表达障碍，从小跟着爷爷奶奶生活，音乐是她最早的倾诉对象和表达方式。</p>
        </div>
        <div class="bg-white rounded-xl border border-primary-100/30 p-4 card-hover">
          <div class="flex items-center gap-3 mb-3">
            <span class="text-2xl">💄</span>
            <p class="text-xs font-bold text-primary-600 uppercase tracking-wider">爱好</p>
          </div>
          <p class="text-sm text-text-secondary leading-relaxed">除了音乐，另一大爱好是美妆。喜欢看美妆视频，节目录制时坚持自己完成眼妆和高光。</p>
        </div>
        <div class="bg-white rounded-xl border border-primary-100/30 p-4 card-hover">
          <div class="flex items-center gap-3 mb-3">
            <span class="text-2xl">🥛</span>
            <p class="text-xs font-bold text-primary-600 uppercase tracking-wider">粉丝名</p>
          </div>
          <p class="text-sm text-text-secondary leading-relaxed">粉丝名为"纯牛奶"。</p>
        </div>
      </div>
    </section>

    <!-- ===== 快速导航 ===== -->
    <section class="text-center py-6">
      <div class="flex flex-wrap justify-center gap-3">
        <a href="/music" class="inline-flex items-center gap-2 px-6 py-3 bg-primary-600 text-white rounded-full text-sm font-medium hover:bg-primary-700 transition-all shadow-sm">
          🎵 探索音乐作品
        </a>
        <a href="/news" class="inline-flex items-center gap-2 px-6 py-3 bg-white text-text-primary border border-primary-200 rounded-full text-sm font-medium hover:bg-primary-50 transition-all">
          📰 最新动态
        </a>
        <a href="/awards" class="inline-flex items-center gap-2 px-6 py-3 bg-white text-text-primary border border-primary-200 rounded-full text-sm font-medium hover:bg-primary-50 transition-all">
          🏆 荣誉奖项
        </a>
      </div>
    </section>
  </Container>
</BaseLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('opacity-100', 'translate-y-0');
          entry.target.classList.remove('opacity-0', 'translate-y-4');
        }
      });
    }, { threshold: 0.1 });
    document.querySelectorAll('.timeline-item').forEach(function (el) {
      el.classList.add('opacity-0', 'translate-y-4', 'transition-all', 'duration-700', 'ease-out');
      observer.observe(el);
    });
  });
</script>
