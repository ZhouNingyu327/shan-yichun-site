---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('news');
  return entries.filter((entry) => entry.data.publicationStatus === 'published').map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { data } = entry;
const sources = data.sources ?? (data.sourceUrl ? [{ name: data.source, url: data.sourceUrl }] : []);
---

<BaseLayout title={data.title} description={data.summary} path={`/news/${entry.id}`}>
  <div class="relative bg-gradient-to-br from-[#0a0a1a] via-[#120a2e] to-[#0f1923] overflow-hidden min-h-screen">
    <div class="fixed inset-0 overflow-hidden pointer-events-none">
      <div class="absolute top-[10%] left-[10%] w-[25rem] h-[25rem] rounded-full blur-[100px] opacity-20 animate-blob" style="background: linear-gradient(135deg, #8b5cf6, #7c3aed)" />
      <div class="absolute bottom-[20%] right-[10%] w-[20rem] h-[20rem] rounded-full blur-[100px] opacity-15 animate-blob animation-delay-2" style="background: linear-gradient(135deg, #ec4899, #f59e0b)" />
    </div>
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[80rem] h-px bg-gradient-to-r from-transparent via-white/15 to-transparent" />

    <Container class="relative z-10 py-16 sm:py-20">
      <article class="max-w-3xl mx-auto">
        <a href="/news" class="inline-flex items-center gap-1.5 text-sm text-white/40 hover:text-white/70 transition-colors mb-8">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          返回最新动态
        </a>

        <div class="flex flex-wrap items-center gap-3 text-sm text-white/40 mb-4">
          <span>{new Date(data.publishDate).toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
          <span>·</span>
          <span>{data.source}</span>
          {data.verificationStatus === 'verified' && (
            <span class="inline-flex items-center rounded-full bg-emerald-400/10 px-2 py-0.5 text-[11px] font-medium text-emerald-200 border border-emerald-300/20">已交叉核验</span>
          )}
          {data.verificationStatus === 'needs_review' && (
            <span class="inline-flex items-center rounded-full bg-amber-300/10 px-2 py-0.5 text-[11px] font-medium text-amber-100 border border-amber-200/20">来源待补充</span>
          )}
        </div>

        <h1 class="text-2xl sm:text-3xl md:text-4xl font-heading font-bold text-white mb-5">{data.title}</h1>
        <p class="text-base sm:text-lg text-white/60 leading-relaxed mb-6">{data.summary}</p>

        <div class="flex flex-wrap gap-2 mb-8">
          {data.tags.map((t) => (
            <a href={`/news?tag=${encodeURIComponent(t)}`} class="text-[11px] px-2.5 py-0.5 rounded-full bg-primary-500/15 text-primary-300 border border-primary-400/20 hover:bg-primary-500/25 transition-colors">{t}</a>
          ))}
        </div>

        <div class="backdrop-blur-xl bg-white/[0.05] rounded-2xl border border-white/10 p-6 sm:p-8 news-prose">
          <slot />
        </div>

        {sources.length > 0 && (
          <div class="mt-8 pt-6 border-t border-white/10">
            <h2 class="text-sm font-semibold text-white/80 mb-3">参考来源</h2>
            <ul class="space-y-2">
              {sources.map((source) => (
                <li>
                  <a href={source.url} target="_blank" rel="noopener noreferrer" class="text-sm text-primary-300 hover:text-primary-200 font-medium">
                    {source.name} →
                  </a>
                  {source.excerpt && <p class="mt-1 text-sm text-white/50">{source.excerpt}</p>}
                </li>
              ))}
            </ul>
          </div>
        )}
      </article>
    </Container>
  </div>
</BaseLayout>

<style is:global>
  @keyframes blob {
    0%, 100% { transform: translate(0, 0) scale(1); }
    25% { transform: translate(40px, -40px) scale(1.05); }
    50% { transform: translate(-30px, 30px) scale(0.95); }
    75% { transform: translate(30px, 40px) scale(1.02); }
  }
  .animate-blob { animation: blob 20s ease-in-out infinite; }
  .animation-delay-2 { animation-delay: 5s; }

  .news-prose p { color: rgba(255,255,255,0.6); line-height: 1.9; margin-bottom: 1em; font-size: 0.95rem; }
  .news-prose strong { color: rgba(255,255,255,0.9); }
  .news-prose h1, .news-prose h2, .news-prose h3 { color: rgba(255,255,255,0.9); margin: 1.5em 0 0.6em; }
  .news-prose ul { list-style: disc; padding-left: 1.5em; margin-bottom: 1em; }
  .news-prose li { color: rgba(255,255,255,0.6); line-height: 1.8; margin-bottom: 0.3em; }
  .news-prose a { color: #a78bfa; }
</style>
